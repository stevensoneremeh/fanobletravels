      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/",
      "destination": "/index.html",
      "statusCode": 307,
      "regex": "^(?!/_next)/(?:/)?$"
    },
    {
