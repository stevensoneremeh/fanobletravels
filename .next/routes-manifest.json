      "regex": "^/fairs/china(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/fairs/china(?:/)?$"
    },
    {
      "page": "/medical-tourism",
      "regex": "^/medical\\-tourism(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/medical\\-tourism(?:/)?$"
    },
    {
      "page": "/tours/israel",
      "regex": "^/tours/israel(?:/)?$",
      "routeKeys": {},
